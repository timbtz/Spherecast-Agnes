# Agnes Environment Variables
# Copy this file to .env and fill in your values

# Anthropic (required for Claude API calls — claude-sonnet-4-6)
# Get at https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# Google ADK (required for web search via Gemini 2.5 Flash)
# Get a free key at https://aistudio.google.com
GOOGLE_API_KEY=your_key_here
GOOGLE_GENAI_USE_VERTEXAI=false

# NIH DSLD v9 (required — without key, v9 returns 0 hits)
# Request at https://dsld.od.nih.gov/api-guide
DSLD_API_KEY=your_key_here

# USDA FoodData Central (free, optional — for food-grade ingredients)
# Sign up at https://fdc.nal.usda.gov/api-key-signup/
USDA_FDC_API_KEY=your_key_here

# openFDA (optional — higher rate limits with key vs anonymous)
# Request at https://open.fda.gov/apis/authentication/
OPEN_FDA_API_KEY=your_key_here

# Molport (free tier: 10k req/month — for chemical supplier pricing)
# Register at https://www.molport.com
MOLPORT_API_KEY=your_key_here
